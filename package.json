{
  "name": "@hueke/hueke",
  "version": "0.0.3",
  "description": "A double-entry bookkeeping command line and library",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stellarator-studio/hueke.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "assets"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./assets/*": "./assets/*"
  },
  "bin": {
    "hueke": "./dist/cli/main.js"
  },
  "scripts": {
    "prepare": "pnpm generate",
    "generate": "antlr-ng -Dlanguage=TypeScript --generate-visitor=false --generate-listener=false -o srcs/io/parser/generated srcs/io/parser/Hueke.g4",
    "clean": "node -e \"for (const d of ['srcs/io/parser/generated', 'dist']) fs.rmSync(d, { recursive: true, force: true })\"",
    "build": "pnpm generate && tsc -p tsconfig.build.json",
    "check": "pnpm clean && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "typecheck": "pnpm generate && tsc --noEmit",
    "test": "pnpm generate && vitest run",
    "lint": "pnpm generate && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "pnpm clean && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "antlr-ng": "1.0.10",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "antlr4ng": "3.0.16",
    "temporal-polyfill": "1.0.5"
  }
}
